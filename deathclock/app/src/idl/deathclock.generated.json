    {
      "name": "Proof",
      "docs": [
        "Groth16 proof elements on BN254 curve",
        "- pi_a must be a point in G1",
        "- pi_b must be a point in G2",
        "- pi_c must be a point in G1",
        "Note: pi_a must be negated before calling verify"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "pi_a",
            "type": {
              "array": [
                "u8",
                64
              ]
            }
          },
          {
            "name": "pi_b",
            "type": {
              "array": [
                "u8",
                128
              ]
            }
          },
          {
            "name": "pi_c",
            "type": {
              "array": [
                "u8",
                64
              ]
            }
          }
        ]
      }
    },
