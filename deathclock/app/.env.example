# DeathClock frontend configuration.
#
# Copy to `.env.local` for local development, or set these in the Vercel
# project settings. Every value has a working default in
# `src/utils/constants.ts` and `src/utils/verifier.ts` — the defaults are the
# DEVNET deployment, so the app runs against devnet with no configuration at
# all. Set a variable only to point somewhere else.
#
# These are public values baked into the client bundle, not secrets. Nothing
# here should ever hold a private key: the app signs through Phantom, so it
# never needs one.

# --- Program addresses -------------------------------------------------------
# DeathClock program. Default: the devnet deployment.
NEXT_PUBLIC_PROGRAM_ID=C8unxtjoDZWy2GmwHUPuSve1BHT5TtRKpNaDofbMS5Vh

# RISC Zero verifier router, which DeathClock CPIs into.
NEXT_PUBLIC_ROUTER_PROGRAM_ID=5n8zx79RUHafwSSB4vRU5ao9atHzJQHTdJR9ty8YrVte

# The BN254 Groth16 verifier the router dispatches to.
NEXT_PUBLIC_GROTH16_VERIFIER_PROGRAM_ID=2iPoTWMXWJ6inLnBeGEZyiKkwEzaQvCX24Cp82UcWm8K

# --- Cluster -----------------------------------------------------------------
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# `devnet` or `localnet`; only affects explorer links.
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_EXPLORER_URL=https://explorer.solana.com

# For the Docker validator instead:
#   NEXT_PUBLIC_RPC_URL=http://localhost:8899
#   NEXT_PUBLIC_NETWORK=localnet
#   NEXT_PUBLIC_PROGRAM_ID=BF1Y36xBRoQVB7z3gi5rSnciAHwbn5yMn8ToSnZ8Woo
#   NEXT_PUBLIC_ROUTER_PROGRAM_ID=6JvFfBrvCcWgANKh1Eae9xDq4RC6cfJuBcf71rp2k9Y7
#   NEXT_PUBLIC_GROTH16_VERIFIER_PROGRAM_ID=THq1qFYQoh7zgcjXoMXduDBqiZRCPeg3PvvMbrVQUge
